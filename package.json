{
  "name": "@pamelasprin47685ghall/localspace-js",
  "version": "2.0.0",
  "description": "LocalSpace JS \u5de5\u5177\u9762\uff1aopen_workspace + js \u7f16\u7a0b\u9762\uff08ChatGPT MCP\uff09\u3002",
  "homepage": "https://github.com/PamelaSprin47685ghall/localspace-js#readme",
  "bugs": {
    "url": "https://github.com/PamelaSprin47685ghall/localspace-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PamelaSprin47685ghall/localspace-js.git"
  },
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.19 <27"
  },
  "bin": {
    "localspace": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "benchmark:mcp": "tsx scripts/benchmark-mcp.mjs",
    "dev": "node scripts/dev-server.mjs",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "start": "node dist/cli.js serve",
    "validate:package": "node scripts/validate-package-install.mjs",
    "test": "tsx src/config.test.ts && tsx src/program/program.test.ts && tsx src/roots.test.ts && tsx src/workspaces.test.ts && tsx src/concurrency.test.ts && tsx src/audit-log.test.ts && tsx src/oauth-store.test.ts && tsx src/cli.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "coding-agent",
    "local-workspace",
    "developer-tools"
  ],
  "author": "Alan-512",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pierre/diffs": "^1.2.5",
    "better-sqlite3": "^12.10.0",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.3",
    "vite": "^8.0.14"
  },
  "overrides": {
    "ws": "8.21.0",
    "undici": "8.5.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0",
    "typescript": "^6.0.3"
  }
}
